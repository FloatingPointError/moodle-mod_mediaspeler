{{!
    @template mod_mediaspeler/player

    Player for one practice series (UC3, fase 5). Every instance has its own root element, so
    several players can sit on one page (UC14, UC15).

    Context variables required for this template:
    * uniqid - Id of the root element, unique on the page
    * cmid - Course module id
    * threshold - Share of an item that counts as listened to (0-1)
    * first - The item that is loaded first
    * items - The items, in the suggested order: id, position, title, description (HTML), src, listened,
      groups (names, only filled for teachers)

    Example context (json):
    {
        "uniqid": "mediaspeler123",
        "cmid": 5,
        "threshold": 0.75,
        "first": {"id": 1, "title": "Intro", "src": "#"},
        "items": [
            {"id": 1, "position": 1, "title": "Intro", "description": "<p>Luister naar de bas.</p>", "src": "#", "listened": true},
            {"id": 2, "position": 2, "title": "Couplet", "description": "", "src": "#", "listened": false,
             "groups": [{"name": "Cello"}]}
        ]
    }
}}
<div class="mod-mediaspeler-player" id="{{uniqid}}" data-cmid="{{cmid}}" data-threshold="{{threshold}}">
    <div class="mod-mediaspeler-now card mb-3">
        <div class="card-body">
            <p class="mb-1 small text-muted">{{#str}} nowplaying, mod_mediaspeler {{/str}}</p>
            <p class="h5 mb-2" data-region="now-title">{{first.title}}</p>
            <audio class="d-block w-100" controls preload="metadata" data-region="audio"
                src="{{first.src}}" data-itemid="{{first.id}}"></audio>
            <div class="mt-2 d-flex align-items-center gap-2" data-region="progress-wrap">
                <div class="progress flex-grow-1" style="height: .5rem;">
                    <div class="progress-bar" role="progressbar" data-region="progress" style="width: 0%;"
                        aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"
                        aria-label="{{#str}} listenedshare, mod_mediaspeler {{/str}}"></div>
                </div>
                <span class="small text-muted" data-region="progress-text">0%</span>
            </div>
        </div>
    </div>

    <p class="small text-muted">{{#str}} freeorder, mod_mediaspeler {{/str}}</p>
    <ol class="list-group list-group-numbered mod-mediaspeler-items">
        {{#items}}
        <li class="list-group-item d-flex align-items-start gap-2{{#current}} active{{/current}}" data-region="item"{{#current}} aria-current="true"{{/current}}
            data-itemid="{{id}}" data-src="{{src}}" data-title="{{title}}" data-listened="{{#listened}}1{{/listened}}{{^listened}}0{{/listened}}">
            <div class="flex-grow-1">
                <button type="button" class="btn btn-link p-0 text-start fw-bold{{#current}} text-white{{/current}}" data-action="select">{{title}}</button>
                {{#groups.0}}
                <div class="mt-1" data-region="groups">
                    <span class="visually-hidden">{{#str}} itemgroups, mod_mediaspeler {{/str}}:</span>
                    {{#groups}}<span class="badge bg-secondary text-dark me-1">{{name}}</span>{{/groups}}
                </div>
                {{/groups.0}}
                {{#description}}<div class="small mt-1">{{{description}}}</div>{{/description}}
            </div>
            <span class="badge bg-success" data-region="listened" {{^listened}}hidden{{/listened}}>
                {{#pix}} i/checked, core {{/pix}}{{#str}} listened, mod_mediaspeler {{/str}}
            </span>
        </li>
        {{/items}}
    </ol>
</div>
